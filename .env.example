LLM_ROUTER_DATA_DIR=.local/data
LLM_ROUTER_HOST=127.0.0.1
LLM_ROUTER_PORT=18080
# Enable when served over HTTPS.
LLM_ROUTER_SECURE_COOKIES=false
# Optional: default generated key is kept in LLM_ROUTER_DATA_DIR/encryption.key (0600).
# LLM_ROUTER_ENCRYPTION_KEY=
# Optional explicit public origin when behind a reverse proxy.
# LLM_ROUTER_PUBLIC_ORIGIN=https://router.example

